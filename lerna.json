{
  "version": "independent",
  "npmClient": "pnpm",
  "packages": [
    "packages/*",
    "rescript/*",
    "reventless/*",
    "examples/**"
  ],
  "command": {
    "publish": {
      "registry": "https://npm.pkg.github.com",
      "conventionalCommits": true,
      "changelogPreset": "@reventlessdev/reventless-conventional-changelog",
      "message": "chore(release): publish packages",
      "ignoreChanges": [
        "**/*.md",
        "**/*.test.js",
        "**/*.spec.js",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ]
    },
    "version": {
      "conventionalCommits": true,
      "changelogPreset": "@reventlessdev/reventless-conventional-changelog",
      "message": "chore(release): version packages",
      "allowBranch": [
        "main",
        "master",
        "alpha",
        "beta"
      ],
      "createRelease": "github"
    },
    "bootstrap": {
      "hoist": "true"
    }
  },
  "ignoreChanges": [
    "**/*.md",
    "**/*.test.js",
    "**/*.spec.js",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**"
  ],
  "$schema": "node_modules/lerna/schemas/lerna-schema.json"
}
