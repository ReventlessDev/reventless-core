{
  "name": "@reventlessdev/reventless-vscode-protocol",
  "version": "1.0.0-alpha.14",
  "description": "Shared NDJSON contract (StreamEvent) between the reventless-gwt CLI (--format=vscode) and the reventless-vscode extension — a single sury @schema both emit and decode.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rescript build",
    "watch": "rescript build -w",
    "clean": "rescript clean && rm -rf lib",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "dev": "NODE_OPTIONS='--experimental-vm-modules' jest --watchAll"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "dependencies": {
    "@rescript/runtime": "12.3.0",
    "sury": "11.0.0-alpha.4"
  },
  "devDependencies": {
    "@reventlessdev/rescript-jest": "workspace:*",
    "rescript": "^12.3.0",
    "sury-ppx": "11.0.0-alpha.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
