{
  "name": "@reventlessdev/reventless-infra",
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "namespace": "ReventlessInfra",
  "ppx-flags": [
    "sury-ppx/bin"
  ],
  "warnings": {
    "error": "-44+101"
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "tests",
      "subdirs": true,
      "type": "dev"
    }
  ],
  "dependencies": [
    "sury",
    "@reventlessdev/rescript-pulumi-pulumi",
    "@reventlessdev/rescript-effect",
    "@reventlessdev/rescript-uuid",
    "@reventlessdev/reventless-spec",
    "@reventlessdev/rescript-jest"
  ],
  "suffix": ".res.mjs"
}
