open Reventless.Behavior;
open Reventless.Message;
open {{properCase name}};

module Spec = {{properCase name}};

type state = {.};

let resolverConfig = {commandDecoder: command_decode, fields: [||]};

let create: create(command, event, error) =
  (. command, context, error) =>
    switch (command) {
    | Add => [Added]
    };

let execute: execute(state, command, event, error) =
  (. state, command, context, error) =>
    switch (command) {
    | Add => error(AlreadyExisting, command, context)
    };

let invalidEvent = event => 
  Js.Exn.raiseError(
    "InvalidEvent: " ++ event_encode(event)->Js.Json.stringify,
  );

let init: init(state, event) =
  (. event) =>
    switch (event) {
    | Added => {}
    };

let apply: apply(state, event) =
  (. state, event) =>
    switch (event) {
    | Added => invalidEvent(event)
    };
