{
  "name": "@reventlessdev/reventless-interop",
  "version": "1.0.0-alpha.6",
  "description": "Versioned cross-plugin contract types and compatibility validation for Reventless",
  "license": "MIT",
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "dev": "jest --watchAll"
  },
  "dependencies": {
    "@reventlessdev/rescript-pulumi-pulumi": "^2.3.0-alpha.3",
    "sury": "^11.0.0-alpha.4",
    "sury-ppx": "^11.0.0-alpha.2"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "rescript": "^12.2.0"
  },
  "peerDependencies": {
    "rescript": "^12.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
