    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "dev": "jest --watchAll"
  },
  "dependencies": {
    "@reventlessdev/rescript-pulumi-pulumi": "workspace:*",
    "sury": "11.0.0-alpha.4",
    "sury-ppx": "11.0.0-alpha.2"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "rescript": "^12.2.0"
  },
  "peerDependencies": {
    "rescript": "^12.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReventlessDev/reventless-core.git",
    "directory": "reventless/reventless-interop"
  }
