{
  "name": "@reventlessdev/reventless-domain-protocol",
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "namespace": "ReventlessDomainProtocol",
  "ppx-flags": ["sury-ppx/bin"],
  "dependencies": ["sury"],
  "dev-dependencies": ["@reventlessdev/rescript-jest"],
  "gentypeconfig": {
    "module": "commonjs",
    "generatedFileExtension": ".gen.ts"
  },
  "warnings": {
    "error": "-44+101"
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": false
    },
    {
      "dir": "tests",
      "subdirs": false,
      "type": "dev"
    }
  ]
}
