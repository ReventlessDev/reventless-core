{
  "name": "@reventlessdev/reventless-gwt",
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "namespace": "ReventlessGwt",
  "ppx-flags": [
    "@reventlessdev/reventless-ppx/bin",
    "sury-ppx/bin"
  ],
  "warnings": {
    "error": "-44+101"
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "tests",
      "subdirs": true,
      "type": "dev"
    }
  ],
  "dependencies": [
    "sury",
    "@glennsl/rescript-jest",
    "@reventlessdev/rescript-effect",
    "@reventlessdev/reventless-infra",
    "@reventlessdev/reventless-spec",
    "@reventlessdev/reventless-core"
  ],
  "compiler-flags": [],
  "suffix": ".res.mjs"
}
