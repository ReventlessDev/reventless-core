{
  "name": "@reventlessdev/reventless-gwt",
  "version": "1.0.0-alpha.24",
  "description": "Given-When-Then DSLs and CLI runner for Reventless slice testing",
  "license": "MIT",
  "bin": {
    "reventless-gwt": "./bin/reventless-gwt.mjs"
  },
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "pnpm run clean && pnpm run build -- -with-deps",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "dependencies": {
    "@reventlessdev/rescript-effect": "workspace:*",
    "@reventlessdev/reventless-core": "workspace:*",
    "@reventlessdev/reventless-infra": "workspace:*",
    "@reventlessdev/reventless-spec": "workspace:*",
    "chokidar": "^3.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "@reventlessdev/reventless-ppx": "workspace:*",
    "rescript": "^12.2.0",
    "sury": "11.0.0-alpha.4",
    "sury-ppx": "11.0.0-alpha.2"
  },
  "peerDependencies": {
    "rescript": "^12.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
