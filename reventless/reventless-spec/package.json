{
  "name": "@reventlessdev/reventless-spec",
  "version": "3.0.0-alpha.27",
  "description": "Specifications for Reventless",
  "license": "MIT",
  "bin": {
    "generate-plugin": "./src/generator/PluginGenerator.res.mjs"
  },
  "scripts": {
    "build": "rescript build",
    "postbuild": "node -e \"const f='src/generator/PluginGenerator.res.mjs',fs=require('fs'),c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);fs.chmodSync(f,0o755)\"",
    "start": "rescript start",
    "clean": "rescript clean"
  },
  "dependencies": {
    "jsonschema2graphql": "1.1.1",
    "sury": "^11.0.0-alpha.4",
    "sury-ppx": "^11.0.0-alpha.2"
  },
  "devDependencies": {
    "rescript": "^12.2.0"
  },
  "peerDependencies": {
    "rescript": "^12.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
