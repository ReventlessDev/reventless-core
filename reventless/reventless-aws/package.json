{
  "name": "@reventlessdev/reventless-aws",
  "version": "3.0.0-alpha.7",
  "description": "AWS adapters for Reventless",
  "license": "MIT",
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "deploy": "./scripts/deploy.sh",
    "test": "echo \"There are no tests for reventless-aws.\"",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@reventlessdev/rescript-aws-sdk": "^2.2.0-alpha.0",
    "@reventlessdev/rescript-effect": "*",
    "@reventlessdev/rescript-pulumi-aws": "^2.3.1-alpha.5",
    "@reventlessdev/rescript-pulumi-pulumi": "^2.2.1-alpha.4",
    "@reventlessdev/rescript-uuid": "^1.1.0-alpha.0",
    "@reventlessdev/reventless-core": "^3.0.0-alpha.7",
    "@reventlessdev/reventless-infra": "^3.0.0-alpha.0",
    "@reventlessdev/reventless-spec": "^3.0.0-alpha.3"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "rescript": "^12.1.0",
    "sury": "^11.0.0-alpha.4",
    "sury-ppx": "^11.0.0-alpha.2"
  },
  "peerDependencies": {
    "rescript": "^12.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
