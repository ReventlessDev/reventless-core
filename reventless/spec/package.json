{
  "name": "@reventlessdev/reventless-spec",
  "version": "3.0.0-alpha.87",
  "description": "Specifications for Reventless",
  "license": "Apache-2.0",
  "bin": {
    "generate-plugin": "./run-generator.mjs",
    "generate-platform": "./run-platform-generator.mjs"
  },
  "scripts": {
    "build": "rescript build",
    "start": "rescript start",
    "clean": "rescript clean",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "dev": "NODE_OPTIONS='--experimental-vm-modules' jest --watchAll"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "dependencies": {
    "jsonschema2graphql": "1.1.1",
    "sury": "11.0.0-alpha.4",
    "sury-ppx": "11.0.0-alpha.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@reventlessdev/rescript-jest": "workspace:*",
    "rescript": "12.3.0"
  },
  "peerDependencies": {
    "rescript": "12.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReventlessDev/reventless-core.git",
    "directory": "reventless/spec"
  }
}
