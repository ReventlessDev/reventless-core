{
  "name": "@reventlessdev/reventless-layer-builder",
  "version": "3.0.0-alpha.26",
  "description": "aws lambda layer to be used in reventless based projects",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/Main.res.mjs",
  "directories": {
    "lib": "src"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "rescript build && node ./src/Main.res.mjs",
    "test": "rescript build && NODE_OPTIONS='--experimental-vm-modules' jest",
    "dev": "NODE_OPTIONS='--experimental-vm-modules' jest --watchAll"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/ReventlessDev/reventless-core/issues"
  },
  "devDependencies": {
    "@reventlessdev/rescript-jest": "workspace:*",
    "rescript": "12.3.0"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.4.2",
    "@reventlessdev/rescript-node": "workspace:*",
    "ora": "^6.3.1",
    "pacote": "^21.5.0",
    "rimraf": "^6.1.3",
    "treeverse": "^3.0.0",
    "zip-a-folder": "^1.1.7"
  }
}
