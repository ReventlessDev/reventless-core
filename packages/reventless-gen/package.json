    "plop-templates",
    "plop-templates/Plugin/.gitignore",
    "plop-templates/Plugin/plugin/.npmrc",
    "plop-templates/Plugin/ui/.npmrc",
    "plop-templates/Project/platform/.gitignore"
  ],
  "preferGlobal": true,
  "dependencies": {
    "plop": "^3.1.0",
    "pluralize": "^8.0.0"
