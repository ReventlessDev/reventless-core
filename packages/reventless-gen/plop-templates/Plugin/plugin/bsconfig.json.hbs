{
  "name": "@{{dashCase platformName}}-{{dashCase pluginName}}/spec",
  "namespace": "{{properCase pluginName}}Spec",
  "reason": {
    "react-jsx": 3
  },
  "refmt": 3,
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "tests",
      "subdirs": true,
      "type": "dev"
    }
  ],
  "package-specs": {
    "module": "commonjs",
    "in-source": true
  },
  "suffix": ".bs.js",
  "bs-dependencies": [
    "@reventless/rescript-aws-sdk",
    "@reventless/bs-pulumi-aws",
    "@reventless/bs-pulumi-pulumi",
    "@reventless/bs-uuid",
    "@reventless/reventless-spec",
    "@reventless/reventless",
    "@reventless/reventless-aws",
    "@ryb73/decco"
  ],
  "bs-dev-dependencies": [
    "@glennsl/bs-jest"
  ],
  "ppx-flags": [
    "@ryb73/decco/ppx/ppx_decco.sh"
  ]
}