module Mappings = {
  let name = "{{properCase extensionName}}";
  module type Mapping =
    Reventless.ExtensionMapping.T with
      module ExtensionPoint := {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint;

  let mappings: array(module Mapping) = [|
    (module {{properCase extensionPointName}}Extension_{{properCase aggregateName}}.Mapping),
  |];
};

include Reventless.Extension.Make(
          {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint,
          Mappings,
        );
