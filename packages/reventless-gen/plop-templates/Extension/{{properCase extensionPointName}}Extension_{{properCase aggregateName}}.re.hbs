open {{properCase pluginName}}Spec;

module Impl = {
  open ReventlessSpec.ExtensionMapping;

  module Aggregate = {{properCase aggregateName}};
  module ExtensionPoint = {{properCase extensionPointName}}ExtensionPoint;

  let generateCommands =
      (
        queryEngine: ReventlessSpec.QueryEngine.t,
        {{camelCase extensionPointName}}Id,
        command: {{properCase aggregateName}}.command,
      ) =>
    queryEngine.query(
      ~viewName={{properCase aggregateName}}.name,
      ~key="{{camelCase extensionPointName}}Id",
      ~id=String({{camelCase extensionPointName}}Id),
      (),
    )
    |> Js.Promise.then_(
         fun
         | [||] => {
             Js.log2("no {{properCase aggregateName}} yet for {{camelCase extensionPointName}}Id: ", {{camelCase extensionPointName}}Id);
             [||]->Js.Promise.resolve;
           }
         | {{pluralize aggregateName}} => {
             {{pluralize aggregateName}}
             ->Belt.Array.keepMap({{camelCase aggregateName}} =>
                 {{camelCase aggregateName}}->{{properCase aggregateName}}View.queryResult_decode
                 |> (
                   fun
                   | Belt.Result.Ok({id}) => Some((id, command))
                   | Error(err) => {
                       Js.log2(
                         __MODULE__ ++ ": Couldn't decode result:",
                         err,
                       );
                       None;
                     }
                 )
               )
             ->Js.Promise.resolve;
           },
       );

  let mapIncomingEvent =
    ({{camelCase extensionPointName}}Id, event, _meta, _pluginDef, queryEngine) => {
      switch (event) {
      | {{properCase extensionPointName}}ExtensionPoint.Event => [|
          PublishAggregateCommandsAsync(
            generateCommands(queryEngine, {{camelCase extensionPointName}}Id, {{properCase aggregateName}}.Command),
          ),
        |]
      };
    };

  let mapOutgoingEvent =
    (_id, event, _meta, _pluginDef) =>
      switch (event) {
      | {{properCase aggregateName}}.Event({{camelCase extensionPointName}}Id) => [|
          PublishExtensionPointCommand({{camelCase extensionPointName}}Id, {{properCase extensionPointName}}ExtensionPoint.Command),
        |]
      | _ => [||]
      };
};

module Mapping =
  Reventless.ExtensionMapping.Make(
    {{properCase extensionPointName}}ExtensionPoint,
    Impl,
  );
