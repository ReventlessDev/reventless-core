open Reventless.View;
open Reventless.Message;
open {{properCase name}};

[@decco]
type state = {statusChange};

let name = None;

let resolveIdConfigs = [];
let resolveIdsConfigs = [];

let sortConfig = None;

let indexes = [];

let invalidEvent = event => raise(InvalidEvent(event_encode(event)));

let init: init(state, event) =
  (. event, {meta: {time, user}}) =>
    switch (event) {
    | Added => [{
                  statusChange: {
                    at: time,
                    by: user,
                  },
                }]
    };

let apply: apply(state, event) =
  (. state, event, {meta: {time, user}}) =>
    switch (event) {
    | Added => invalidEvent(event)
    };

let applyMulti: applyMulti(state, event) =
  (. states, event, context) =>
    states
    |> List.map(state => apply(. state, event, context))
    |> List.flatten;
