module Impl = {
  open ReventlessSpec.ExtensionPointMapping;

  module Aggregate = Location;

  let mapIncomingCommand = ({{camelCase aggregateName}}Id, command, _meta) =>
    switch (command) {
    | {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint.Added => [|
        PublishCommand({{camelCase aggregateName}}Id, {{properCase aggregateName}}.Add),
      |]
    };

  let mapOutgoingEvent = ({{camelCase aggregateName}}Id, event, _meta, _queryEngine) =>
    switch (event) {
    | {{properCase aggregateName}}.Added => [|
        PublishEvent(
          {{camelCase aggregateName}}Id,
          {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint.Added,
        ),
      |]
    | _ => [||]
    };
};

module Mapping =
  Reventless.ExtensionPointMapping.Make(
    {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint,
    Impl,
  );
