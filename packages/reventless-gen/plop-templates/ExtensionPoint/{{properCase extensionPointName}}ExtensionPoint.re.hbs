module Mappings = {
  module type Mapping =
    Reventless.ExtensionPointMapping.T with
      module ExtensionPoint := {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint;

  let mappings: array(module Mapping) = [|
    (module {{properCase extensionPointName}}ExtensionPoint_{{properCase aggregateName}}.Mapping),
  |];
};

include ReventlessAws.ExtensionPoint.Make(
          {{properCase pluginName}}Spec.{{properCase extensionPointName}}ExtensionPoint,
          Mappings,
        );
