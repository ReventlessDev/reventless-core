{
  "name": "@{{dashCase platformName}}/core",
  "version": "0.0.1",
  "description": "{{platformName}} - Core Stack",
  "private": true,
  "main": "./src/Main.bs.js",
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "../scripts/deploy.sh",
    "test": "jest --testPathPattern=\"_test.bs.js\"",
    "test:ci": "jest --coverage --ci --testResultsProcessor=\"./node_modules/jest-junit-reporter\" --testPathPattern=_test.bs.js --passWithNoTests",
    "test:all": "jest -c ../jest.config.js",
    "test:watch": "jest --watchAll --testPathPattern=_test.bs.js",
    "test:watch:coverage": "jest --testPathPattern=_test.bs.js --coverage --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:{{dashCase platformName}}/platform.git"
  },
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "jest": "^26.6.3",
    "jest-junit-reporter": "^1.1.0"
  },
  "dependencies": {
    "@pulumi/aws": "4.37.4",
    "@pulumi/pulumi": "3.24.1",
    "@reventless/reventless-aws": "1.1.0-alpha.47",
    "uuid": "3.4.0",
    "bs-platform": "^5.2.1"
  }
}