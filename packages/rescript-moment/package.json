    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc"
  },
  "peerDependencies": {
    "moment": "^2.26.0",
    "rescript": "^12.1.0"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "husky": "^4.2.5",
    "moment": "^2.26.0",
    "rescript": "^12.1.0"
  }
}
