module Make = (RuntimeEnvironment: Runtime.Environment): (
  Runtime_Builder.T
    with type context = RuntimeEnvironment.context
    and type parts = RuntimeEnvironment.parts
) => {
  type context = RuntimeEnvironment.context
  type parts = RuntimeEnvironment.parts

  type handler<'e, 'r> = Runtime.eventHandler<'e, context, 'r>
  type handlers<'e, 'r> = dict<Pulumi.Output.t<handler<'e, 'r>>>

  // let aggregateRuntimes = Js.Dict.empty()
  let aggregateCommandGeneratorHandlers = Js.Dict.empty()
  // let aggregateCommandTopicHandlers: handlers<'e, 'r> = Js.Dict.empty()
  // let aggregateEventCollectorHandlers: handlers<'e, 'r> = Js.Dict.empty()

  let aggregateHandler /* : string => handler<'e, 'r> */ = aggregateName => async (event, _) => ()

  let forAggregate = (~memorySize=?, ~timeout=?, aggregate: Pulumi.Resource.t) => {
    let aggregateName = aggregate.name->Option.getOr("")
    RuntimeEnvironment.make(
      ~name=aggregateName->ComponentType.name(CommandGenerator.componentType),
      ~handler=aggregateHandler(aggregateName)->Pulumi.Output.make,
      ~memorySize?,
      ~timeout?,
      ~opts={Pulumi.ComponentResource.parent: aggregate},
    )
  }

  let forAggregateCommandGenerator = (
    ~handler: Pulumi.Output.t<CommandGenerator.commandGenerator>,
    ~memorySize=1024,
    ~timeout=30,
    commandGenerator: CommandGenerator.component,
  ) => {
    let commandGeneratorResource = commandGenerator->Component.toPulumiResource
    let commandGeneratorName = commandGeneratorResource.name->Option.getOr("Unnamed")
    switch commandGeneratorResource.parent {
    | Some(aggregateResource) =>
      let aggregateName = aggregateResource.name->Option.getExn
      aggregateCommandGeneratorHandlers->Js.Dict.set(aggregateName, handler)
      aggregateResource->forAggregate(~memorySize, ~timeout)
    | None =>
      Js.Exn.raiseError(
        `Runtime_Builder_Medium.forAggregateCommandGenerator: commandGenerator ${commandGeneratorName} has no Aggregate parent`,
      )
    }
  }
