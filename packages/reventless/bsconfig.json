{
  "name": "@reventless/reventless",
  "namespace": "Reventless",
  "suffix": ".bs.js",
  "refmt": 3,
  "ppx-flags": [
    "@ryb73/decco/ppx/ppx_decco.sh"
  ],
  "warnings": {
    "error": "-44+101"
  },
  "package-specs": {
    "module": "commonjs",
    "in-source": true
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "tests",
      "subdirs": true
    },
    {
      "dir": "test-helper",
      "subdirs": true
    }
  ],
  "bs-dependencies": [
    "@ryb73/decco",
    "bs-moment",
    "@aantron/repromise",
    "@glennsl/bs-jest",
    "@reventless/reventless-spec",
    "@reventless/bs-aws-sdk",
    "@reventless/bs-fast-csv",
    "@reventless/bs-hash-obj",
    "@reventless/bs-node-streams",
    "@reventless/bs-pulumi-aws",
    "@reventless/bs-pulumi-pulumi",
    "@reventless/bs-ssh2",
    "@reventless/bs-uuid"
  ]
}
