{
    "name": "@reventless/reventless",
    "namespace": "Reventless",
    "suffix": ".res.js",
    "ppx-flags": [
        "sury-ppx/bin"
    ],
    "warnings": {
        "error": "-44+101"
    },
    "package-specs": {
        "module": "commonjs",
        "in-source": true
    },
    "sources": [
        {
            "dir": "src",
            "subdirs": true
        },
        {
            "dir": "tests",
            "subdirs": true
        },
        {
            "dir": "test-helper",
            "subdirs": true
        }
    ],
    "bs-dependencies": [
        "@rescript/core",
        "sury",
        "@glennsl/rescript-jest",
        "@reventless/rescript-aws-sdk",
        "@reventless/rescript-fast-csv",
        "@reventless/rescript-hash-obj",
        "@reventless/rescript-node-streams",
        "@reventless/rescript-pulumi-aws",
        "@reventless/rescript-pulumi-pulumi",
        "@reventless/rescript-ssh2",
        "@reventless/rescript-uuid",
        "@reventless/reventless-spec"
    ],
    "pinned-dependencies": [
        "@reventless/reventless-spec",
        "@reventless/rescript-aws-sdk",
        "@reventless/rescript-fast-csv",
        "@reventless/rescript-hash-obj",
        "@reventless/rescript-node-streams",
        "@reventless/rescript-pulumi-aws",
        "@reventless/rescript-pulumi-pulumi",
        "@reventless/rescript-ssh2",
        "@reventless/rescript-uuid"
    ],
    "bsc-flags": [
        "-open RescriptCore"
    ],
    "external-stdlib": "@rescript/std"
}