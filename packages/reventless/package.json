{
    "name": "@reventless/reventless",
    "version": "2.3.3",
    "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
    "author": "Atos",
    "license": "proprietary",
    "repository": {
        "type": "git",
        "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
    },
    "publishConfig": {
        "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
    },
    "jest": {
        "testMatch": [
            "**/tests/**/*Test.res.js"
        ]
    },
    "scripts": {
        "build": "rescript build",
        "start": "rescript build -w",
        "clean": "rescript clean",
        "rebuild": "npm run clean && npm run build -- -with-deps",
        "deploy": "./scripts/deploy.sh",
        "test": "jest",
        "test:watch": "jest --watchAll",
        "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
        "dev": "jest --watchAll",
        "watch:screen": "screen -c .screenrc",
        "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
    },
    "dependencies": {
        "@reventless/rescript-aws-sdk": "^2.1.2",
        "@reventless/rescript-fast-csv": "^1.1.2",
        "@reventless/rescript-hash-obj": "^1.1.1",
        "@reventless/rescript-node-streams": "^1.0.1",
        "@reventless/rescript-pulumi-aws": "^2.3.0",
        "@reventless/rescript-pulumi-pulumi": "^2.2.0",
        "@reventless/rescript-ssh2": "^1.0.2",
        "@reventless/rescript-uuid": "^1.0.1",
        "@reventless/reventless-spec": "^2.3.0"
    },
    "devDependencies": {
        "@glennsl/rescript-jest": "^0.13.1",
        "rescript": "^12.1.0",
        "sury": "^11.0.0-alpha.4",
        "sury-ppx": "^11.0.0-alpha.2"
    },
    "peerDependencies": {
        "rescript": "^12.1.0"
    },
    "gitHead": "ddea51534dc210635d7b11968089627b3b697ce2"
}
