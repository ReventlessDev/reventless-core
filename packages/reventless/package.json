{
    "name": "@reventless/reventless",
    "version": "1.5.0-node20.19",
    "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
    "author": "Atos",
    "license": "proprietary",
    "keywords": [
        "bucklescript",
        "reasonml",
        "event",
        "event-sourcing",
        "cqrs",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
    },
    "publishConfig": {
        "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
    },
    "jest": {
        "testMatch": [
            "**/tests/**/*Test.bs.js"
        ]
    },
    "scripts": {
        "build": "rescript build",
        "start": "rescript build -w",
        "clean": "rescript clean",
        "rebuild": "npm run clean && npm run build -- -with-deps",
        "deploy": "./scripts/deploy.sh",
        "test": "jest",
        "test:watch": "jest --watchAll",
        "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
        "dev": "jest --watchAll",
        "watch:screen": "screen -c .screenrc",
        "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
    },
    "dependencies": {
        "@rescript/std": "^10.1.4",
        "@reventless/bs-aws-sdk": "^1.4.0-node20.9",
        "@reventless/bs-fast-csv": "^0.4.5",
        "@reventless/bs-hash-obj": "^0.2.0",
        "@reventless/bs-node-streams": "^0.3.5",
        "@reventless/bs-pulumi-aws": "^1.3.0-node20.10",
        "@reventless/bs-pulumi-pulumi": "^1.2.1-node20.3",
        "@reventless/bs-ssh2": "^0.4.0-node20.0",
        "@reventless/bs-uuid": "^0.2.0",
        "@reventless/reventless-spec": "^1.5.0-node20.4",
        "bs-moment": "^0.8.0",
        "decco": "1.6.0",
        "moment": "^2.27.0"
    },
    "devDependencies": {
        "@glennsl/rescript-jest": "^0.9.2",
        "@ryyppy/rescript-promise": "^2.1.0",
        "jest": "^27.3.1",
        "rescript": "^10.1.4"
    },
    "peerDependencies": {
        "@rescript/std": "^10.1.4",
        "rescript": "^10.1.4"
    },
    "gitHead": "ff84af8727c17ff34a44afda2e6dcdec0a3ce758"
}
