{
    "name": "@reventless/reventless",
    "version": "1.2.0-alpha.0",
    "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
    "author": "Atos",
    "license": "proprietary",
    "keywords": [
        "bucklescript",
        "reasonml",
        "event",
        "event-sourcing",
        "cqrs",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
    },
    "publishConfig": {
        "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
    },
    "jest": {
        "testMatch": [
            "**/tests/**/*Test.bs.js"
        ]
    },
    "scripts": {
        "build": "bsb -make-world",
        "start": "bsb -make-world -w",
        "clean": "bsb -clean-world",
        "rebuild": "npm run clean && npm run build",
        "deploy": "./scripts/deploy.sh",
        "test": "jest",
        "test:watch": "jest --coverage --watchAll",
        "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
        "dev": "jest --watchAll",
        "watch:screen": "screen -c .screenrc",
        "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
    },
    "dependencies": {
        "@reventless/bs-aws-sdk": "^1.1.2-alpha.0",
        "@reventless/bs-fast-csv": "^0.2.9",
        "@reventless/bs-hash-obj": "^0.1.6",
        "@reventless/bs-node-streams": "^0.1.6",
        "@reventless/bs-pulumi-aws": "^1.1.2-alpha.0",
        "@reventless/bs-pulumi-pulumi": "^1.1.1",
        "@reventless/bs-ssh2": "^0.1.6",
        "@reventless/bs-uuid": "^0.1.7",
        "@reventless/reventless-spec": "^1.2.0-alpha.0",
        "decco": "1.3.0",
        "bs-moment": "^0.7.0",
        "moment": "^2.27.0"
    },
    "devDependencies": {
        "@glennsl/bs-jest": "^0.5.1",
        "bs-platform": "^7.3.2"
    },
    "peerDependencies": {
        "bs-platform": "^7.3.2"
    },
    "gitHead": "1016edd2eceed939132c050a8ec292dc898a405f"
}