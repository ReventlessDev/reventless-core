{
    "name": "@reventless/reventless",
    "version": "2.0.3-runtime.19",
    "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
    "author": "Atos",
    "license": "proprietary",
    "keywords": [
        "bucklescript",
        "reasonml",
        "event",
        "event-sourcing",
        "cqrs",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
    },
    "publishConfig": {
        "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
    },
    "jest": {
        "testMatch": [
            "**/tests/**/*Test.bs.js"
        ]
    },
    "scripts": {
        "build": "rescript build",
        "start": "rescript build -w",
        "clean": "rescript clean",
        "rebuild": "npm run clean && npm run build -- -with-deps",
        "deploy": "./scripts/deploy.sh",
        "test": "jest",
        "test:watch": "jest --watchAll",
        "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
        "dev": "jest --watchAll",
        "watch:screen": "screen -c .screenrc",
        "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
    },
    "dependencies": {
        "@rescript-labs/decco": "^2.0.4",
        "@rescript/core": "^1.6.0",
        "@rescript/std": "^11.1.4",
        "@reventless/bs-aws-sdk": "^2.0.0",
        "@reventless/bs-fast-csv": "^1.0.0",
        "@reventless/bs-hash-obj": "^1.0.0",
        "@reventless/bs-node-streams": "^1.0.0",
        "@reventless/bs-pulumi-aws": "^2.0.1-runtime.3",
        "@reventless/bs-pulumi-pulumi": "^2.0.1-runtime.1",
        "@reventless/bs-ssh2": "^1.0.0",
        "@reventless/bs-uuid": "^1.0.0",
        "@reventless/reventless-spec": "^2.0.1-runtime.5"
    },
    "devDependencies": {
        "@glennsl/rescript-jest": "^0.11.0",
        "rescript": "^11.1.4"
    },
    "peerDependencies": {
        "@rescript/std": "^11.1.4",
        "rescript": "^11.1.4"
    }
}
