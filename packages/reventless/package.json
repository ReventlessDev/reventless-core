{
  "name": "@reventless-universe/reventless",
  "version": "0.1.126",
  "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
  "author": "Atos",
  "license": "proprietary",
  "keywords": [
    "bucklescript",
    "reasonml",
    "event",
    "event-sourcing",
    "cqrs",
    "serverless"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:reventless-universe/reventless-universe.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*Test.bs.js"
    ]
  },
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "test:watch": "jest --coverage --watchAll",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@aantron/repromise": "^0.6.0",
    "@reventless-universe/bs-aws-sdk": "^0.1.16",
    "@reventless-universe/bs-fast-csv": "^0.1.3",
    "@reventless-universe/bs-hash-obj": "^0.1.2",
    "@reventless-universe/bs-node-streams": "^0.1.2",
    "@reventless-universe/bs-pulumi-aws": "^0.1.21",
    "@reventless-universe/bs-pulumi-pulumi": "^0.1.5",
    "@reventless-universe/bs-ssh2": "^0.1.2",
    "@reventless-universe/bs-uuid": "^0.1.2",
    "@reventless-universe/reventless-spec": "^0.1.2",
    "@ryb73/decco": "0.0.12",
    "bs-moment": "^0.6.0",
    "fast-csv": "chrwnsk/fast-csv#build",
    "hash-obj": "^2.0.0",
    "moment": "^2.27.0",
    "ssh2": "^0.8.5",
    "uuid": "^3.3.2"
  },
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "@pulumi/aws": "^1.18.0",
    "@pulumi/pulumi": "^1.9.0",
    "aws-sdk": "^2.556.0"
  },
  "peerDependencies": {
    "bs-platform": "^5.2.1"
  }
}
