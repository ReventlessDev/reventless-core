{
  "name": "@reventless/reventless-aws",
  "version": "2.3.3",
  "description": "AWS adapters for Reventless",
  "license": "MIT",
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@reventless/rescript-aws-sdk": "^2.1.2",
    "@reventless/rescript-pulumi-aws": "^2.3.0",
    "@reventless/rescript-pulumi-pulumi": "^2.2.0",
    "@reventless/reventless": "^2.3.3",
    "@reventless/reventless-spec": "^2.3.0"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "rescript": "^12.1.0",
    "sury": "^11.0.0-alpha.4",
    "sury-ppx": "^11.0.0-alpha.2"
  },
  "peerDependencies": {
    "rescript": "^12.1.0"
  }
}
