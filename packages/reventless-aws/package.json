{
  "name": "reventless-aws",
  "version": "0.0.1",
  "description": "AWS adapters for Reventless",
  "private": true,
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json",
    "prepublishOnly": "npm run clean && (rm -rf lib & rm -f .merlin) && cd ../..; npm run gitpkg-link ./packages/reventless-aws/package.json",
    "postpublish": "git checkout package.json & echo 'Please ensure the CHANGELOG is up to date!'",
    "gitpkg": "../../node_modules/.bin/gitpkg publish"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:atos-austria/reason/reventless.git"
  },
  "author": "Atos",
  "license": "proprietary",
  "dependencies": {
    "reventless": "0.0.2"
  },
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "@pulumi/aws": "^1.18.0",
    "@pulumi/pulumi": "^1.9.0",
    "aws-sdk": "^2.556.0"
  },
  "peerDependencies": {
    "bs-platform": "^5.2.1"
  }
}