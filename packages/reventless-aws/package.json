{
  "name": "@reventless-universe/reventless-aws",
  "version": "0.1.25-alpha.1",
  "description": "AWS adapters for Reventless",
  "author": "Atos",
  "license": "proprietary",
  "repository": {
    "type": "git",
    "url": "git@github.com:reventless-universe/reventless-universe.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@reventless-universe/bs-aws-sdk": "^0.1.3",
    "@reventless-universe/bs-pulumi-aws": "^0.1.12",
    "@reventless-universe/bs-pulumi-pulumi": "^0.1.4",
    "@reventless-universe/reventless": "^0.1.50-alpha.1"
  },
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "@pulumi/aws": "^1.18.0",
    "@pulumi/pulumi": "^1.9.0"
  },
  "peerDependencies": {
    "bs-platform": "^5.2.1"
  }
}
