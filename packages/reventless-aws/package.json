{
  "name": "@reventless/reventless-aws",
  "version": "1.1.0-alpha.69",
  "description": "AWS adapters for Reventless",
  "author": "Atos",
  "license": "proprietary",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
  },
  "publishConfig": {
    "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
  },
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@reventless/bs-aws-sdk": "^1.1.0-alpha.1",
    "@reventless/bs-pulumi-aws": "^1.1.0-alpha.10",
    "@reventless/bs-pulumi-pulumi": "^1.1.0-alpha.3",
    "@reventless/reventless": "^1.1.0-alpha.57",
    "@reventless/reventless-spec": "^1.1.0-alpha.4",
    "@ryb73/decco": "0.0.12"
  },
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "@pulumi/aws": "^4.37.4",
    "@pulumi/pulumi": "^3.24.1",
    "bs-platform": "^5.2.1"
  },
  "peerDependencies": {
    "bs-platform": "^5.2.1"
  },
  "gitHead": "1016edd2eceed939132c050a8ec292dc898a405f"
}
