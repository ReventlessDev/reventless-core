{
  "name": "@reventless/reventless-aws",
  "version": "1.3.0-rescript.16",
  "description": "AWS adapters for Reventless",
  "author": "Atos",
  "license": "proprietary",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.com:reventless/reventless-universe.git"
  },
  "publishConfig": {
    "@reventless:registry": "https://gitlab.com/api/v4/projects/24127696/packages/npm/"
  },
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc",
    "cloc": "cloc . --exclude-dir=node_modules,lib,milk,tmp-bs-platform --not-match-f=package.*\\.json"
  },
  "dependencies": {
    "@reventless/bs-aws-sdk": "^1.2.0-rescript.9",
    "@reventless/bs-pulumi-aws": "^1.2.0-rescript.13",
    "@reventless/bs-pulumi-pulumi": "^1.2.0-rescript.8",
    "@reventless/reventless": "^1.3.0-rescript.13",
    "@reventless/reventless-spec": "^1.3.0-rescript.12",
    "decco": "1.6.0"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.9.2",
    "rescript": "^9.1.4"
  },
  "peerDependencies": {
    "rescript": "^9.1.4"
  },
  "gitHead": "1fa850fb6e18d4a5c9790608ed19c4d9677f6999"
}
