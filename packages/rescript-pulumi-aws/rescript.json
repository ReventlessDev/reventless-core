{
  "name": "@reventless/rescript-pulumi-aws",
  "namespace": "PulumiAws",
  "suffix": ".res.js",
  "ppx-flags": ["rescript-schema-ppx/bin"],
  "warnings": {
    "error": "-44+101"
  },
  "package-specs": {
    "module": "commonjs",
    "in-source": true
  },
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "bs-dependencies": [
    "@rescript/core",
    "@reventless/rescript-pulumi-pulumi",
    "@reventless/rescript-aws-sdk",
    "rescript-schema"
  ],
  "bsc-flags": [
    "-open RescriptCore",
    "-open RescriptSchema"
  ],
  "pinned-dependencies": [
    "@reventless/rescript-pulumi-pulumi"
  ],
  "external-stdlib": "@rescript/std"
}