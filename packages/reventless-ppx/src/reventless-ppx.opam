opam-version: "2.0"
name: "reventless-ppx"
version: "1.0.0-alpha.1"
synopsis: "ReScript PPX to eliminate boilerplate from Reventless application code"
license: "MIT"
depends: [
  "ocaml" {>= "4.12.1"}
  "dune" {>= "3.19"}
  "ppxlib" {= "0.34.0"}
  "yojson" {>= "2.0.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
