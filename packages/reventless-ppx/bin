#!/bin/sh
# Resolve and exec the reventless-ppx native binary for the current platform.
#
# Resolution order:
#   1. The matching per-platform package @reventlessdev/reventless-ppx-<platform>
#      (declared as an optionalDependency; npm/pnpm install only the one whose
#      os/cpu match). Three layouts covered:
#        a. sibling in node_modules (npm flat / pnpm hoisted, same package dir)
#        b. nested under this package's own node_modules (pnpm strict / per-pkg)
#        c. hoisted to an ancestor node_modules (pnpm hoisted in a workspace —
#           the per-platform pkg lands at the *workspace root* node_modules,
#           not at the consumer's or this package's level)
#   2. A locally-built or committed fallback binary in this directory — covers PPX
#      development (`pnpm build:ppx`) and the pre-publish transition window.
#
# Windows is served via WSL2 (which presents as Linux-x86_64); there is no native
# Windows binary.
DIR="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)   PKG="linux-x64";    LOCAL="ppx-linux.exe" ;;
  Linux-aarch64)  PKG="linux-arm64";  LOCAL="ppx-linux-arm.exe" ;;
  Darwin-x86_64)  PKG="darwin-x64";   LOCAL="ppx-osx-x64.exe" ;;
  Darwin-arm64)   PKG="darwin-arm64"; LOCAL="ppx-osx.exe" ;;
  *) echo "reventless-ppx: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

# (1a) sibling in node_modules; (1b) nested under this package; (2) local fallback.
for CAND in \
  "$DIR/../reventless-ppx-$PKG/ppx.exe" \
  "$DIR/node_modules/@reventlessdev/reventless-ppx-$PKG/ppx.exe" \
  "$DIR/$LOCAL"; do
  # `-f` (exists), not `-x`: npm/pnpm normalize file modes to 0644 when installing
  # from a published tarball (only package.json `bin` targets are guaranteed +x),
  # so the native binary often arrives non-executable. Restore +x, then exec.
  if [ -f "$CAND" ]; then chmod u+x "$CAND" 2>/dev/null; exec "$CAND" "$@"; fi
done

# (1c) Walk up ancestor directories looking for a node_modules with the matching
# per-platform package — covers pnpm's hoisted workspace layout, where the
# optionalDep lands at the workspace root rather than at this package's level.
ANCESTOR="$DIR"
while [ "$ANCESTOR" != "/" ] && [ -n "$ANCESTOR" ]; do
  ANCESTOR="$(dirname "$ANCESTOR")"
  CAND="$ANCESTOR/node_modules/@reventlessdev/reventless-ppx-$PKG/ppx.exe"
  if [ -f "$CAND" ]; then chmod u+x "$CAND" 2>/dev/null; exec "$CAND" "$@"; fi
done

echo "reventless-ppx: no binary found for $(uname -s)-$(uname -m)." >&2
echo "  Expected package @reventlessdev/reventless-ppx-$PKG, or a local build at $DIR/$LOCAL." >&2
echo "  For PPX development: (cd \"$DIR/src\" && opam exec -- dune build) && cp \"$DIR/src/_build/default/bin/bin.exe\" \"$DIR/$LOCAL\"" >&2
exit 1
