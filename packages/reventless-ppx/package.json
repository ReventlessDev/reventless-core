{
  "name": "@reventlessdev/reventless-ppx",
  "version": "1.0.0-alpha.42",
  "description": "ReScript PPX to eliminate boilerplate from Reventless application code",
  "license": "Apache-2.0",
  "files": [
    "bin"
  ],
  "bin": {
    "reventless-ppx": "bin"
  },
  "scripts": {
    "build:ppx": "cd src && opam exec -- dune build",
    "clean:ppx": "cd src && opam exec -- dune clean",
    "publish:platform": "node ../../scripts/publish-ppx-local.mjs",
    "test": "./test/run.sh"
  },
  "optionalDependencies": {
    "@reventlessdev/reventless-ppx-darwin-arm64": "^1.0.0-alpha.42",
    "@reventlessdev/reventless-ppx-linux-x64": "^1.0.0-alpha.42"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReventlessDev/reventless-core.git",
    "directory": "packages/reventless-ppx"
  }
}
