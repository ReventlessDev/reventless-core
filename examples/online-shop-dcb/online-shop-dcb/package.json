{
  "name": "@reventlessdev/online-shop-dcb",
  "version": "1.0.0-alpha.9",
  "description": "Online Shop example — full DCB platform with Catalog + Ordering plugins (in-memory)",
  "license": "MIT",
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "run": "npx tsx src/Main.res.mjs",
    "dev": "GRAPHQL_DEBUG=1 MCP_DEBUG=1 npx tsx src/Main.res.mjs"
  },
  "dependencies": {
    "@reventlessdev/online-shop-dcb-catalog": "*",
    "@reventlessdev/online-shop-dcb-catalog-spec": "*",
    "@reventlessdev/online-shop-dcb-ordering": "*",
    "@reventlessdev/online-shop-dcb-ordering-spec": "*",
    "@reventlessdev/reventless-in-memory": "*",
    "@reventlessdev/reventless-spec": "*"
  },
  "devDependencies": {
    "rescript": "^12.2.0",
    "sury": "^11.0.0-alpha.4",
    "sury-ppx": "^11.0.0-alpha.2"
  },
  "peerDependencies": {
    "rescript": "^12.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
