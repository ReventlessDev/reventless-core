{
  "name": "@reventlessdev/online-shop-aggregates",
  "version": "1.0.0-alpha.1",
  "description": "Online Shop example — full aggregate platform with Catalog + Ordering plugins (in-memory)",
  "private": true,
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "run": "npx tsx src/Main.res.mjs",
    "dev": "GRAPHQL_DEBUG=1 MCP_DEBUG=1 npx tsx src/Main.res.mjs"
  },
  "dependencies": {
    "@reventlessdev/reventless-spec": "*",
    "@reventlessdev/reventless-in-memory": "*",
    "@reventlessdev/online-shop-aggregates-catalog": "*",
    "@reventlessdev/online-shop-aggregates-ordering": "*"
  }
}
