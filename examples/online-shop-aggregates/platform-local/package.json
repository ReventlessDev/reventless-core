{
  "name": "@reventlessdev/online-shop-aggregates-platform-local",
  "private": true,
  "version": "1.0.0-alpha.76",
  "description": "Online Shop example — full aggregate platform with Catalog + Ordering plugins (in-memory)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rescript build",
    "start": "rescript watch",
    "clean": "rescript clean",
    "rebuild": "pnpm run clean && pnpm run build -- -with-deps",
    "run": "npx tsx src/Main.res.mjs",
    "dev": "GRAPHQL_DEBUG=1 MCP_DEBUG=1 npx tsx src/Main.res.mjs"
  },
  "dependencies": {
    "@reventlessdev/online-shop-aggregates-catalog": "workspace:*",
    "@reventlessdev/online-shop-aggregates-catalog-spec": "workspace:*",
    "@reventlessdev/online-shop-aggregates-ordering": "workspace:*",
    "@reventlessdev/online-shop-aggregates-ordering-spec": "workspace:*",
    "@reventlessdev/rescript-pulumi-pulumi": "workspace:*",
    "@reventlessdev/reventless-infra": "workspace:*",
    "@reventlessdev/reventless-local": "workspace:*",
    "@reventlessdev/reventless-spec": "workspace:*",
    "sury": "^11.0.0-alpha.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@reventlessdev/reventless-ppx": "workspace:*",
    "sury-ppx": "11.0.0-alpha.2"
  }
}
