{
  "name": "@reventlessdev/online-shop-hybrid-platform-in-memory",
  "private": true,
  "version": "1.0.0-alpha.75",
  "description": "Online Shop Hybrid example — full platform with Catalog + Ordering plugins (in-memory)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "pnpm run clean && pnpm run build -- -with-deps",
    "test": "NODE_OPTIONS='--experimental-vm-modules' npx jest",
    "serve": "REVENTLESS_LOCAL_BACKEND=${REVENTLESS_LOCAL_BACKEND:-sqlite:./.reventless/local.db} npx tsx src/Main.res.mjs",
    "serve:memory": "REVENTLESS_LOCAL_BACKEND=memory pnpm run serve",
    "serve:reset": "REVENTLESS_LOCAL_BACKEND='sqlite:./.reventless/local.db?reset' pnpm run serve",
    "serve:watch": "REVENTLESS_LOCAL_BACKEND=${REVENTLESS_LOCAL_BACKEND:-sqlite:./.reventless/local.db} npx tsx watch --clear-screen=false --exclude '**/node_modules/**' --include '../../../reventless/*/src/**/*.res.mjs' --include '../*/src/**/*.res.mjs' src/Main.res.mjs",
    "dev": "REVENTLESS_LOCAL_BACKEND=${REVENTLESS_LOCAL_BACKEND:-sqlite:./.reventless/local.db} GRAPHQL_DEBUG=1 MCP_DEBUG=1 npx tsx src/Main.res.mjs",
    "dev:ui": "[ -d reventless-ui ] && pnpm --filter ./reventless-ui run dev:ui || reventless-host-shell",
    "dev:full": "REVENTLESS_LOCAL_BACKEND=${REVENTLESS_LOCAL_BACKEND:-sqlite:./.reventless/local.db} concurrently --names rs,backend,ui --prefix-colors blue,cyan,magenta 'pnpm -w run watch' 'pnpm run serve:watch' 'npx wait-on tcp:4001 && pnpm run dev:ui'",
    "dev:full:memory": "REVENTLESS_LOCAL_BACKEND=memory pnpm run dev:full",
    "dev:full:reset": "REVENTLESS_LOCAL_BACKEND='sqlite:./.reventless/local.db?reset' pnpm run dev:full"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs",
      "<rootDir>/tests/**/*_GWT.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ],
    "moduleNameMapper": {
      "^@npmcli/arborist$": "<rootDir>/__mocks__/emptyModule.js",
      "^spdx-license-ids$": "<rootDir>/../../../node_modules/spdx-license-ids/index.json",
      "^spdx-license-ids/deprecated$": "<rootDir>/../../../node_modules/spdx-license-ids/deprecated.json",
      "^spdx-exceptions$": "<rootDir>/../../../node_modules/spdx-exceptions/index.json"
    }
  },
  "optionalDependencies": {
    "@reventlessdev/reventless-host-shell": "3.0.0-alpha.22"
  },
  "dependencies": {
    "@reventlessdev/online-shop-hybrid-catalog": "workspace:*",
    "@reventlessdev/online-shop-hybrid-catalog-spec": "workspace:*",
    "@reventlessdev/online-shop-hybrid-ordering": "workspace:*",
    "@reventlessdev/online-shop-hybrid-ordering-spec": "workspace:*",
    "@reventlessdev/rescript-pulumi-pulumi": "workspace:*",
    "@reventlessdev/reventless-in-memory": "workspace:*",
    "@reventlessdev/reventless-infra": "workspace:*",
    "@reventlessdev/reventless-spec": "workspace:*",
    "sury": "^11.0.0-alpha.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@glennsl/rescript-jest": "^0.13.1",
    "@reventlessdev/reventless-gwt": "workspace:*",
    "@reventlessdev/reventless-ppx": "workspace:*",
    "sury-ppx": "11.0.0-alpha.2"
  }
}
