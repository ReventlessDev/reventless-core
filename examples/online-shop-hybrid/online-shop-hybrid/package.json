{
  "name": "@reventlessdev/online-shop-hybrid",
  "version": "1.0.0-alpha.1",
  "description": "Online Shop Hybrid example — full platform with Catalog + Ordering plugins (in-memory)",
  "private": true,
  "scripts": {
    "build": "rescript build",
    "start": "rescript build -w",
    "clean": "rescript clean",
    "rebuild": "npm run clean && npm run build -- -with-deps",
    "run": "npx tsx src/Main.res.mjs",
    "dev": "GRAPHQL_DEBUG=1 MCP_DEBUG=1 npx tsx src/Main.res.mjs"
  },
  "dependencies": {
    "@reventlessdev/online-shop-hybrid-catalog": "^1.0.0-alpha.1",
    "@reventlessdev/online-shop-hybrid-catalog-spec": "^1.0.0-alpha.1",
    "@reventlessdev/online-shop-hybrid-ordering": "^1.0.0-alpha.1",
    "@reventlessdev/online-shop-hybrid-ordering-spec": "^1.0.0-alpha.1",
    "@reventlessdev/reventless-in-memory": "*",
    "@reventlessdev/reventless-spec": "*"
  }
}
