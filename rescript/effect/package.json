{
  "name": "@reventlessdev/rescript-effect",
  "version": "1.0.0-alpha.0",
  "description": "ReScript bindings for the Effect TypeScript library",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rescript build",
    "start": "rescript watch",
    "clean": "rescript clean",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' npx jest",
    "dev": "jest --watchAll"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "dependencies": {
    "@reventlessdev/rescript-jest": "workspace:*",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "rescript": "12.3.1"
  },
  "peerDependencies": {
    "rescript": "^12.3.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReventlessDev/reventless-core.git",
    "directory": "rescript/effect"
  }
}
