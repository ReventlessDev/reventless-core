{
  "name": "@reventlessdev/rescript-moment",
  "version": "0.10.0-alpha.15",
  "description": "ReScript bindings for Moment.js",
  "license": "Apache-2.0",
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*Test.res.mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs"
    ]
  },
  "scripts": {
    "build": "rescript build",
    "start": "rescript watch",
    "clean": "rescript clean",
    "deploy": "./scripts/deploy.sh",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc"
  },
  "peerDependencies": {
    "moment": "^2.30.1",
    "rescript": "^12.3.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "moment": "^2.30.1",
    "rescript": "^12.3.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReventlessDev/reventless-core.git",
    "directory": "rescript/rescript-moment"
  },
  "dependencies": {
    "@reventlessdev/rescript-jest": "workspace:*"
  }
}
