{
  "name": "reventless-monorepo",
  "private": true,
  "description": "Reventless Core - Event-sourced CQRS framework for serverless infrastructure",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ReventlessDev/reventless-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@reventlessdev/reventless-conventional-changelog": "workspace:*",
    "@reventlessdev/reventless-ppx": "workspace:*",
    "@reventlessdev/rescript-aws-sdk": "workspace:*",
    "@reventlessdev/rescript-fast-csv": "workspace:*",
    "@reventlessdev/rescript-hash-object": "workspace:*",
    "@reventlessdev/rescript-moment": "workspace:*",
    "@reventlessdev/rescript-node-streams": "workspace:*",
    "@reventlessdev/rescript-node-zlib": "workspace:*",
    "@reventlessdev/rescript-pulumi-aws": "workspace:*",
    "@reventlessdev/rescript-pulumi-pulumi": "workspace:*",
    "@reventlessdev/rescript-ssh2": "workspace:*",
    "@reventlessdev/rescript-graphql-yoga": "workspace:*",
    "@reventlessdev/rescript-mcp-sdk": "workspace:*",
    "@reventlessdev/rescript-effect": "workspace:*",
    "@reventlessdev/rescript-jest": "workspace:*",
    "@reventlessdev/rescript-uuid": "workspace:*",
    "@reventlessdev/reventless-spec": "workspace:*",
    "@reventlessdev/reventless-infra": "workspace:*",
    "@reventlessdev/reventless-interop": "workspace:*",
    "@reventlessdev/reventless-core": "workspace:*",
    "@reventlessdev/reventless-gwt": "workspace:*",
    "@reventlessdev/reventless-local": "workspace:*",
    "@reventlessdev/reventless-aws": "workspace:*",
    "@reventlessdev/online-shop-hybrid-platform-aws": "workspace:*",
    "lerna": "^8.2.4",
    "rescript": "^12.3.0",
    "yaml": "^2.8.3"
  },
  "scripts": {
    "setup": "node ./scripts/setup.mjs",
    "build": "rescript build && rescript build examples/online-shop-aggregates/platform-local && rescript build examples/online-shop-dcb/platform-local && rescript build examples/online-shop-hybrid/platform-local",
    "watch": "rescript watch",
    "clean": "rescript clean",
    "format": "rescript format",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --silent",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --watchAll --silent",
    "test:watch:fail": "ONLY_FAILURES=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --watchAll --silent",
    "dev": "concurrently --names rs,jest --prefix-colors cyan,yellow \"rescript watch\" \"NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --watchAll --silent\"",
    "dev:fail": "concurrently --names rs,jest --prefix-colors cyan,yellow \"rescript watch\" \"ONLY_FAILURES=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings --max-old-space-size=4096' jest --watchAll --silent\"",
    "test:integration": "echo 'No integration tests configured' || exit 0",
    "test:unit": "pnpm -r run test --if-present",
    "test:coverage": "echo 'No coverage script configured' || exit 0",
    "link:on": "node ./scripts/apply-workspace-overlay.mjs && pnpm install",
    "link:off": "node ./scripts/restore-workspace-base.mjs && pnpm install",
    "link:status": "node ./scripts/workspace-link-status.mjs"
  },
  "pnpm": {
    "overrides": {
      "@docusaurus/theme-common": "3.9.2",
      "graphql": "^16.0.0",
      "webpackbar": "^7.0.0"
    }
  },
  "version": "",
  "packageManager": "pnpm@10.33.0"
}
