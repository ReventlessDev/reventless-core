{
  "name": "@reventlessdev/reventless-core",
  "private": true,
  "description": "Reventless Core - Event-sourced CQRS framework for serverless infrastructure",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ReventlessDev/reventless-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "workspaces": [
    "packages/*",
    "examples/**"
  ],
  "devDependencies": {
    "conventional-changelog-reventless": "file:./conventional-changelog-reventless",
    "lerna": "^8.1.8",
    "rescript": "^12.1.0"
  },
  "scripts": {
    "build": "rescript build",
    "watch": "rescript watch",
    "clean": "rescript clean",
    "format": "rescript format",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "echo 'No integration tests configured' || exit 0",
    "test:unit": "npm run test --workspaces --if-present",
    "test:coverage": "echo 'No coverage script configured' || exit 0"
  },
  "version": ""
}
