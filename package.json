{
  "name": "reventless",
  "version": "0.0.1",
  "description": "Toolkit for event-sourced CQRS applications on serverless infrastructure written in ReasonML.",
  "scripts": {
    "build": "bsb -make-world",
    "start": "bsb -make-world -w",
    "clean": "bsb -clean-world",
    "rebuild": "npm run clean && npm run build",
    "deploy": "./scripts/deploy.sh",
    "test": "jest",
    "coverage": "nyc report --temp-directory=coverage --reporter=text-lcov | coveralls",
    "dev": "jest --watchAll",
    "watch:bsb": "bsb -make-world -w",
    "watch:jest": "jest --coverage --watchAll",
    "watch:screen": "screen -c .screenrc"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:atos-austria/reason/reventless.git"
  },
  "keywords": [
    "bucklescript",
    "reasonml",
    "event",
    "event-sourcing",
    "cqrs",
    "serverless"
  ],
  "author": "Atos",
  "license": "proprietary",
  "dependencies": {},
  "devDependencies": {
    "@glennsl/bs-jest": "^0.4.8",
    "@pulumi/aws": "^0.18.2",
    "@pulumi/cloud-aws": "^0.18.0"
  },
  "peerDependencies": {
    "bs-platform": "^5.0.3"
  }
}
