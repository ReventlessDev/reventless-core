.DS_Store
.merlin
.env
.history
.vscode
npm-debug.log
**/lib
/node_modules/
**/node_modules/
.grapqhl_ppx_cache
coverage
lerna-debug.log
.playwright-mcp

# Compiled example outputs are derived artifacts: regenerated by every root
# rescript build, never part of any package's publish surface. Tracking them
# produces churn that's unstable across root vs standalone builds. Mirrored
# in reventless-ui/.gitignore for cross-repo consistency.
**/example/**/*.res.mjs
**/examples/**/*.res.mjs

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# Reventless PPX dune build output
packages/reventless-ppx/src/_build/

# ast-grep tree-sitter grammar (compiled binary, rebuild with gcc)
rescript.dylib

# Cross-repo dev linking (see docs/guides/cross-repo-dev-linking.md).
# pnpm-workspace.base.yaml is the tracked source of truth.
# pnpm-workspace.yaml is either a symlink to it (release mode) or a
# merged file produced by `pnpm link:on` (link mode) — always local.
# pnpm-workspace.local.yaml is the developer's overlay input.
pnpm-workspace.yaml
pnpm-workspace.local.yaml