# GitHub Packages Registry Configuration
@reventlessdev:registry=https://npm.pkg.github.com
registry=https://registry.npmjs.org

# Authentication token will be provided via GITHUB_TOKEN environment variable
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Package access configuration
access=restricted
fund=false
audit-level=moderate

# Cache and performance settings
prefer-offline=true
progress=true

# Security settings
audit=true
fund=false

# pnpm: required for ReScript compiler compatibility (phantom-dep surface)
node-linker=hoisted

# pnpm 10: restore npm-style auto-execution of prebuild/postbuild scripts
enable-pre-post-scripts=true

# pnpm 10: default changed to false; this repo uses semver ranges (e.g. "^3.0.0-alpha.30")
# in cross-workspace deps, so workspace packages must satisfy those ranges rather than
# fetching stale registry versions.
link-workspace-packages=true
