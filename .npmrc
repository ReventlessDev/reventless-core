# Public npmjs registry (@reventlessdev/* are public scoped packages).
#
# No `_authToken` line, deliberately. Every dependency here is public, so installs
# need no credential — and a line referencing an environment variable would make
# one mandatory in a way that fails badly: when the variable is undefined pnpm
# discards this ENTIRE file, silently dropping `node-linker=hoisted` below and
# leaving @pulumi/* unreachable ("Pulumi SDK has not been installed"), far from
# the cause.
#
# Publishing authenticates through the ~/.npmrc that `actions/setup-node`
# generates from its `registry-url`, using NODE_AUTH_TOKEN — a credential that
# exists only in the job that needs it.
registry=https://registry.npmjs.org

# Package access configuration
access=public
fund=false
audit-level=moderate

# Cache and performance settings
progress=true

# Security settings
audit=true
fund=false

# pnpm: required for ReScript compiler compatibility (phantom-dep surface)
node-linker=hoisted

# pnpm 10: restore npm-style auto-execution of prebuild/postbuild scripts
enable-pre-post-scripts=true

