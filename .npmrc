# Public npmjs registry (@reventlessdev/* are public scoped packages)
registry=https://registry.npmjs.org

# Authentication token (CI publish/install) provided via NPM_TOKEN environment variable
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Package access configuration
access=public
fund=false
audit-level=moderate

# Cache and performance settings
prefer-offline=true
progress=true

# Security settings
audit=true
fund=false

# pnpm: required for ReScript compiler compatibility (phantom-dep surface)
node-linker=hoisted

# pnpm 10: restore npm-style auto-execution of prebuild/postbuild scripts
enable-pre-post-scripts=true

