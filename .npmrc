# GitHub Packages Registry Configuration
@reventlessdev:registry=https://npm.pkg.github.com
registry=https://registry.npmjs.org

# Authentication token will be provided via NODE_AUTH_TOKEN environment variable
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Package access configuration
access=restricted
fund=false
audit-level=moderate

# Cache and performance settings
cache-max=86400000
prefer-offline=true
progress=true

# Security settings
audit=true
fund=false
